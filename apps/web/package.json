    "@types/node": "^22.0.0",
    "@fontsource-variable/manrope": "^5.2.0",
    "@fontsource-variable/dm-sans": "^5.2.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.0.0",
    "typescript": "^6.0.0",
    "vite": "^8.0.12"
