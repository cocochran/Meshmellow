+static bool rpc_coalesce_enabled() {
+    static const bool enabled = [] {
+        const char * value = std::getenv("GGML_RPC_COALESCE");
+        return value != nullptr && std::strcmp(value, "1") == 0;
+    }();
+    return enabled;
+}
